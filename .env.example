ADDR=127.0.0.1:8080
PYTHON=python
STORAGE_PATH=storage
# DB_DRIVER: mysql (MySQL/MariaDB) atau postgres (PostgreSQL). Bila DATABASE_URL diisi,
# skema di dalamnya (mysql:// atau postgres://) yang menentukan. Nilai bawaan: postgres.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pdfforge
DB_USER=pdfforge
DB_PASSWORD=replace-with-a-long-random-password
DB_DRIVER=mysql
DB_SSLMODE=disable
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
MAX_UPLOAD_SIZE_MB=100
MAX_OUTPUT_SIZE_MB=300
MAX_JOB_OUTPUT_SIZE_MB=600
MAX_FILES_PER_JOB=20
MAX_PAGES_PER_FILE=500
MAX_IMAGE_PIXELS=50000000
MAX_IMAGE_JOB_PIXELS=100000000
MAX_ARCHIVE_EXPANDED_MB=512
MAX_ARCHIVE_FILES=1000
MAX_ARCHIVE_COMPRESSION_RATIO=100
JOB_TIMEOUT_SECONDS=300
FILE_EXPIRATION_HOURS=24
WORKER_COUNT=2
MAX_ACTIVE_JOBS_PER_SESSION=3
MAX_QUEUE_JOBS_PER_SESSION=20
MAX_STORED_JOBS=100000
TRUST_PROXY=false
CLAMDSCAN=
